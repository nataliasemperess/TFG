<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="lift1">
    <static>false</static>
    <link name="base_link">
      <collision name="collision">
        <geometry>
          <box>
            <size>1 1 1</size>  <!-- Tamaño del ascensor -->
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>1 1 1</size>  <!-- Tamaño visual del ascensor -->
          </box>
        </geometry>
      </visual>
    </link>

    <!-- Plugin para mover el ascensor -->
    <plugin name="lift_controller_plugin" filename="libLiftControllerPlugin.so">
      <topic>/gazebo/lift1/cmd_vel</topic>   <!-- Tópico para recibir comandos -->
      <frame>base_link</frame>   <!-- Marco de referencia para movimiento -->
    </plugin>
  </model>
</sdf>
